# 배포 이미지와 같은 설정으로 로컬에서 확인할 때 쓰는 값 (비밀 값 없음)
# node --env-file=apps/api/beta-local.env apps/api/src/server.ts  (프로젝트 루트에서, 먼저 웹 빌드 필요)
NODE_ENV=production
PORT=3200
WEB_ROOT=apps/mobile/dist
ROBOTS_NOINDEX=true
DATABASE_PATH=apps/api/var/beta-local.db
# Google Console 리디렉션 URI: http://localhost:3200/v1/auth/google/callback
PUBLIC_URL=http://localhost:3200
